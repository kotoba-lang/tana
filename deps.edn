{:paths ["src"]
 ;; `columnar` and nothing else. The pruning rule has to be the same object
 ;; the engine uses, not a copy of it — a second implementation of `skip?`
 ;; drifts silently in the direction that still returns correct answers.
 :deps {io.github.kotoba-lang/columnar
        {:git/url "https://github.com/kotoba-lang/columnar.git"
         :git/sha "5e165f0f93f5463461d925248859cab339f58d4f"}}
 :aliases
 ;; The Parquet reader is a TEST dependency only. A table root is not a
 ;; Parquet thing — `tana.member` takes a footer as data — but the claim this
 ;; repo makes is about the range a real reader asks for, and only a real
 ;; reader can settle it.
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/org-apache-parquet
                      {:git/url "https://github.com/kotoba-lang/org-apache-parquet.git"
                       :git/sha "8245502682d54c2d6309286fce481eb2d8c91762"}
                      io.github.kotoba-lang/org-apache-arrow
                      {:git/url "https://github.com/kotoba-lang/org-apache-arrow.git"
                       :git/sha "0be75870181f1fa3f3d5b13c031cfad814416b99"}
                      io.github.kotoba-lang/org-ietf-deflate
                      {:git/url "https://github.com/kotoba-lang/org-ietf-deflate.git"
                       :git/sha "e7558036709b673e22673fc2bbd12f3a24144e98"}
                      io.github.kotoba-lang/org-ietf-zstd
                      {:git/url "https://github.com/kotoba-lang/org-ietf-zstd.git"
                       :git/sha "5362525f26e1dd7646cf917e9b485df2028c3967"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
